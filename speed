	--==================================================
	-- HUMANOID
	--==================================================

	local function getHumanoid()
		local character = player.Character

		if not character then
			return nil
		end

		return character:FindFirstChildOfClass("Humanoid")
	end

	local function updatePlayer()
		local humanoid = getHumanoid()

		if humanoid then
			humanoid.WalkSpeed = speedValue
			humanoid.UseJumpPower = true
			humanoid.JumpPower = jumpValue
		end
	end

	--==================================================
	-- UPDATE SPEED
	--==================================================

	local function updateSpeed(playSound)

		speedValue = math.clamp(
			speedValue,
			MIN_SPEED,
			MAX_SPEED
		)

		speedLabel.Text =
			"PLAYER SPEED: " .. speedValue

		speedFill.Size =
			UDim2.fromScale(
				speedValue / MAX_SPEED,
				1
			)

		updatePlayer()

		if playSound then
			pcall(function()
				clickSound:Play()
			end)
		end
	end

	--==================================================
	-- UPDATE JUMP
	--==================================================

	local function updateJump(playSound)

		jumpValue = math.clamp(
			jumpValue,
			MIN_JUMP,
			MAX_JUMP
		)

		jumpLabel.Text =
			"JUMP POWER: " .. jumpValue

		jumpFill.Size =
			UDim2.fromScale(
				jumpValue / MAX_JUMP,
				1
			)

		updatePlayer()

		if playSound then
			pcall(function()
				clickSound:Play()
			end)
		end
	end

	--==================================================
	-- SPEED BUTTONS
	--==================================================

	speedMinus.MouseButton1Click:Connect(function()
		speedValue -= 5
		updateSpeed(true)
	end)

	speedPlus.MouseButton1Click:Connect(function()
		speedValue += 5
		updateSpeed(true)
	end)

	--==================================================
	-- JUMP BUTTONS
	--==================================================

	jumpMinus.MouseButton1Click:Connect(function()
		jumpValue -= 5
		updateJump(true)
	end)

	jumpPlus.MouseButton1Click:Connect(function()
		jumpValue += 5
		updateJump(true)
	end)

	--==================================================
	-- SPEED SLIDER
	--==================================================

	local function setSpeedFromInput(input)

		local x = input.Position.X
		local startX = speedBack.AbsolutePosition.X
		local width = speedBack.AbsoluteSize.X

		local percentage = math.clamp(
			(x - startX) / width,
			0,
			1
		)

		speedValue = math.floor(
			percentage * MAX_SPEED
		)

		updateSpeed(true)
	end

	speedBack.InputBegan:Connect(function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1
			or input.UserInputType ==
			Enum.UserInputType.Touch then

			setSpeedFromInput(input)

		end
	end)

	--==================================================
	-- JUMP SLIDER
	--==================================================

	local function setJumpFromInput(input)

		local x = input.Position.X
		local startX = jumpBack.AbsolutePosition.X
		local width = jumpBack.AbsoluteSize.X

		local percentage = math.clamp(
			(x - startX) / width,
			0,
			1
		)

		jumpValue = math.floor(
			percentage * MAX_JUMP
		)

		updateJump(true)
	end

	jumpBack.InputBegan:Connect(function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1
			or input.UserInputType ==
			Enum.UserInputType.Touch then

			setJumpFromInput(input)

		end
	end)

