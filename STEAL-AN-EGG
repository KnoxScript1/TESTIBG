		fillObject,
		minValue,
		maxValue,
		callback
	)

		local sliderDragging = false

		local function setValue(x)

			local width = barObject.AbsoluteSize.X

			if width <= 0 then
				return
			end

			local relative = math.clamp(
				(x - barObject.AbsolutePosition.X) / width,
				0,
				1
			)

			local value = math.floor(
				minValue + (maxValue - minValue) * relative
			)

			fillObject.Size = UDim2.fromScale(relative, 1)

			callback(value)
		end

		barObject.InputBegan:Connect(function(input)

			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then

				sliderDragging = true
				setValue(input.Position.X)

			end

		end)

		UserInputService.InputChanged:Connect(function(input)

			if sliderDragging then

				if input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch then

					setValue(input.Position.X)

				end
			end

		end)

		UserInputService.InputEnded:Connect(function(input)

			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then

				sliderDragging = false

			end

		end)
	end

	--==================================================
	-- SPEED SLIDER
	--==================================================

	createSlider(
		speedBar,
		speedFill,
		16,
		100,
		function(value)

			speedValue = value
			speedLabel.Text = "Speed: " .. value

			updateCharacter()

		end
	)

	--==================================================
	-- JUMP SLIDER
	--==================================================

	createSlider(
		jumpBar,
		jumpFill,
		50,
		150,
		function(value)

			jumpValue = value
			jumpLabel.Text = "Jump: " .. value

			updateCharacter()

		end
	)

	--==================================================
	-- INITIALIZE
	--==================================================

	updateCharacter()

end)
